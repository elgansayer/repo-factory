[Unit]
Description=Factory data volume: saturn-reference-assets
RequiresMountsFor=/mnt/HC_Volume_106574422
Before=repo-factory@neptune.service repo-factory@hellotalk.service repo-factory@workout-agent.service

[Mount]
What=/mnt/HC_Volume_106574422/repo-factory/host-data/saturn-reference-assets
Where=/home/dev/Sega-Saturn-BIOS
Type=none
Options=bind

[Install]
WantedBy=local-fs.target

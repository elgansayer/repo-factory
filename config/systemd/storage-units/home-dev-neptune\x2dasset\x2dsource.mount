[Unit]
Description=Factory data volume: neptune-asset-source
RequiresMountsFor=/mnt/HC_Volume_106574422
Before=repo-factory@neptune.service repo-factory@hellotalk.service repo-factory@workout-agent.service

[Mount]
What=/mnt/HC_Volume_106574422/repo-factory/host-data/neptune-asset-source
Where=/home/dev/neptune-asset-source
Type=none
Options=bind

[Install]
WantedBy=local-fs.target

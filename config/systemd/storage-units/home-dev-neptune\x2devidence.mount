[Unit]
Description=Factory data volume: neptune-evidence
RequiresMountsFor=/mnt/HC_Volume_106574422
Before=repo-factory@neptune.service repo-factory@hellotalk.service repo-factory@workout-agent.service

[Mount]
What=/mnt/HC_Volume_106574422/repo-factory/host-data/neptune-evidence
Where=/home/dev/neptune-evidence
Type=none
Options=bind

[Install]
WantedBy=local-fs.target

#!/usr/bin/env bash
# Wrapper for `godot` that outputs only failed assertions and script/shader compiler error lines (2 lines of context)
REAL_BIN="$(which -a godot 2>/dev/null | grep -v 'factory-tools/bin' | head -n 1 || echo /var/lib/repo-factory/neptune/repository/.factory-tools/godot)"
if [[ "${FACTORY_RAW_BUILD_LOGS:-0}" == "1" ]]; then
    exec "$REAL_BIN" "$@"
fi
exec /opt/hellotalk-factory/venv/bin/concise-build "$REAL_BIN" "$@"

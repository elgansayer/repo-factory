#!/usr/bin/env bash
# Wrapper for `go test` / `go build` that outputs only failed assertions and compiler error lines (2 lines of context)
REAL_BIN="/usr/local/go/bin/go"
[[ ! -x "$REAL_BIN" ]] && REAL_BIN="$(which -a go 2>/dev/null | grep -v 'factory-tools/bin' | head -n 1 || echo /usr/bin/go)"
if [[ "${FACTORY_RAW_BUILD_LOGS:-0}" == "1" ]] || [[ "${1:-}" != "test" && "${1:-}" != "build" ]]; then
    exec "$REAL_BIN" "$@"
fi
exec /opt/hellotalk-factory/venv/bin/concise-build "$REAL_BIN" "$@"
